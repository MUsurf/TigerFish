# Copy to .env and fill in for `docker compose --profile pi build/up`.
# Path or URL to a JetPack 6.0 (L4T r36.3.0) / Python 3.10 / aarch64 PyTorch wheel.
# The main Dockerfile's build fails without this set — torch/ultralytics install
# is gated on it. Get a matching wheel from NVIDIA's Jetson PyTorch install guide
# or the jetson-ai-lab pypi index for JetPack 6 / CUDA 12.2.
TORCH_WHEEL=https://developer.download.nvidia.com/compute/redist/jp/v60/pytorch/torch-2.4.0a0+3bcc3cddb5.nv24.07.16234504-cp310-cp310-linux_aarch64.whl

