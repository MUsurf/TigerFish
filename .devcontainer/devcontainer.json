{
  "name": "ros2-humble-dev",
  "image": "osrf/ros:humble-desktop",
  "remoteUser": "root",
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/bin/python3",
        "python.analysis.extraPaths": [
          "${workspaceFolder}/install/lib/python3.10/site-packages",
          "/opt/ros/humble/lib/python3.10/site-packages",
          "/opt/ros/humble/local/lib/python3.10/dist-packages"
        ],
        "python.analysis.diagnosticMode": "workspace"
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-iot.vscode-ros"
      ]
    }
  },
  "postCreateCommand": "apt-get update && apt-get install -y python3-pip python3-venv python3-colcon-common-extensions python3-rosdep ros-humble-yasmin ros-humble-yasmin-ros ros-humble-yasmin-viewer && rosdep init || true && rosdep update"
}