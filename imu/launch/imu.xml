<?xml version="1.0" encoding="UTF-8"?>
<!-- <launch xmlns="http://ros.org/ns/launch" version="2.0"> -->
 <launch> 
  <!-- Launch the IMU Processing node -->
  <!-- <include file="$(find-pkg-share process_imu)/launch/process_imu.xml"/> -->
  <include file="/home/ros2_ws/src/process_imu/launch/process_imu.xml"/>


  <!-- Launch teh IMU Driver node -->
  <!-- <node pkg="imu_bno055" exec="bno055_i2c_node" name="bno055_node" output="screen"> -->
  <node name="bno055_node" pkg="imu" exec="bno055_i2c_node" output="screen">
    <param name="device" value="/dev/i2c-1"/>
    <param name="address" value="0x28"/>
    <param name="frame_id" value="imu"/>
  </node>
</launch>
  
